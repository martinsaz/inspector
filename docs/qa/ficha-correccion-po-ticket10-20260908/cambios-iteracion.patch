--- inspector/checklist/wwwroot/css/ProductosServicios/ProductosServicios.css (antes de esta corrección)
+++ inspector/checklist/wwwroot/css/ProductosServicios/ProductosServicios.css
@@ -3083,3 +3083,41 @@
 .ps-ficha-presentations th, .ps-ficha-presentations td { text-align: left; padding: .65rem .4rem; overflow-wrap: anywhere; }
 .ps-ficha-presentations th { color: var(--checkapp-color-muted); font-weight: 600; }
 .ps-ficha-presentations td { border-top: 1px solid var(--checkapp-color-border); }
+
+/* Ficha técnica: distribución compacta, limitada al contenido de consulta. */
+.ps-ficha-general-row {
+    display: grid;
+    gap: 0.85rem;
+    min-width: 0;
+    align-items: start;
+}
+.ps-ficha-general-row:empty { display: none; }
+.ps-ficha-general-row--description,
+.ps-ficha-general-row--tags {
+    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
+}
+.ps-ficha-general-row--classification {
+    grid-template-columns: repeat(4, minmax(0, 1fr));
+}
+.ps-ficha-general-row--classification:not(:has(> :nth-child(4))) {
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+}
+.ps-ficha-general-row > :only-child { grid-column: 1 / -1; }
+.ps-ficha-general-row > * { min-width: 0; overflow-wrap: anywhere; }
+.ps-ficha-general-row .ps-richtext-view { min-width: 0; }
+.ps-ficha-general-row .ps-richtext-view > :last-child { margin-bottom: 0; }
+.ps-ficha-metrics--prices { grid-template-columns: repeat(6, minmax(0, 1fr)); }
+@media (max-width: 991.98px) {
+    .ps-ficha-metrics--prices { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+    .ps-ficha-general-row--classification,
+    .ps-ficha-general-row--classification:not(:has(> :nth-child(4))) {
+        grid-template-columns: repeat(2, minmax(0, 1fr));
+    }
+}
+@media (max-width: 575.98px) {
+    .ps-ficha-general-row--description,
+    .ps-ficha-general-row--tags,
+    .ps-ficha-general-row--classification,
+    .ps-ficha-general-row--classification:not(:has(> :nth-child(4))),
+    .ps-ficha-metrics--prices { grid-template-columns: minmax(0, 1fr); }
+}
