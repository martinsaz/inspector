+/* PO: only redistribute Name/Code and Type/Status within the existing left area. */
+@media (min-width: 992px) {
+    .ps-general-panel .ps-form-grid--hero {
+        grid-template-columns: repeat(6, minmax(0, 1fr));
+        grid-template-rows: 1fr auto 1fr;
+    }
+    .ps-general-panel .ps-form-field--name { grid-column: 1 / span 4; grid-row: 1; }
+    .ps-general-panel .ps-form-field--code { grid-column: 5 / span 2; grid-row: 1; }
+    .ps-general-panel .ps-form-field--description { grid-column: 1 / -1; }
+    .ps-general-panel .ps-form-field--type { grid-column: 1 / span 3; }
+    .ps-general-panel .ps-form-field--status { grid-column: 4 / span 3; }
