@{
    ViewBag.Title = "Formas de pago";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/css/checkapp-theme.css" rel="stylesheet" asp-append-version="true" />

<div class="checkapp-scope checkapp-page">
    <div class="container-fluid checkapp-shell">
        <section class="checkapp-hero">
            <div>
                <p class="checkapp-kicker">Ajustes</p>
                <h1>Formas de pago</h1>
                <p>Esta pantalla base quedo habilitada para la estructura controlada del menu.</p>
            </div>
        </section>

        <section class="checkapp-panel">
            <div class="checkapp-panel-head">
                <div>
                    <span class="checkapp-panel-eyebrow">Placeholder</span>
                    <h2>Formas de pago</h2>
                    <p class="checkapp-panel-copy">La implementacion funcional completa de formas de pago no forma parte de esta iteracion.</p>
                </div>
            </div>
            <div class="checkapp-status-inline">
                Administra las formas de pago disponibles para las operaciones.
            </div>
        </section>
    </div>
</div>
