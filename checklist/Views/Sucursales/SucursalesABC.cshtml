@{
    ViewBag.Title = "Sucursales";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="checkapp-scope checkapp-page ca-catalog-page sucursales-page">
    <div class="container-fluid checkapp-shell">
        <section class="checkapp-hero">
            <div>
                <p class="checkapp-kicker">CheckApp Pro</p>
                <h1>Sucursales</h1>
                <p>Administra sedes, datos de contacto y su relación con razón social y región.</p>
            </div>
            <div class="checkapp-hero-actions">
                <button id="btNuevo" type="button" class="checkapp-btn checkapp-btn-primary">
                    <i class="fa fa-plus"></i>
                    <span>Nuevo</span>
                </button>
            </div>
        </section>

        <section id="accordionFiltrosSucursales" class="checkapp-panel checkapp-accordion is-open">
            <button type="button" class="checkapp-accordion-toggle" aria-expanded="true" aria-controls="accordionFiltrosSucursalesBody">
                <div>
                    <span class="checkapp-panel-eyebrow">Filtros</span>
                    <h3>Encuentra sucursales por nombre, dirección, ciudad, razón social o región.</h3>
                </div>
                <span class="checkapp-accordion-summary">Sin filtros activos</span>
            </button>
            <div class="checkapp-accordion-body" id="accordionFiltrosSucursalesBody">
                <div class="checkapp-accordion-inner">
                    <div class="checkapp-filter-grid ps-filter-grid ca-filter-grid">
                        <label class="checkapp-field ps-filter-field ps-filter-field--search">
                            <span>Búsqueda general</span>
                            <input id="txFiltroSucursalesBusqueda" type="text" placeholder="Sucursal, dirección, teléfono o correo" />
                        </label>
                        <label class="checkapp-field ps-filter-field">
                            <span>Razón Social</span>
                            <select id="cbFiltroSucursalesRazon" class="form-select" aria-label="Razón Social"></select>
                        </label>
                        <label class="checkapp-field ps-filter-field">
                            <span>Región</span>
                            <select id="cbFiltroSucursalesRegion" class="form-select" aria-label="Región"></select>
                        </label>
                        <label class="checkapp-field ps-filter-field">
                            <span>Estatus</span>
                            <select id="cbFiltroSucursalesEstatus" class="form-select" aria-label="Estatus">
                                <option value="activo" selected>Activo</option>
                                <option value="todos">Todos</option>
                                <option value="inactivo">Baja lógica</option>
                            </select>
                        </label>
                    </div>
                    <div class="ps-filter-tail ca-filter-tail">
                        <button id="btBuscarSucursales" type="button" class="checkapp-btn checkapp-btn-secondary ps-filter-search-btn">
                            <i class="fa fa-search"></i>
                            <span>Buscar</span>
                        </button>
                        <button id="btLimpiarSucursales" type="button" class="checkapp-btn checkapp-btn-ghost">
                            <i class="fa fa-eraser"></i>
                            <span>Limpiar</span>
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <section class="checkapp-panel">
            <div class="checkapp-panel-head">
                <div>
                    <span class="checkapp-panel-eyebrow">Catálogo operativo</span>
                    <h2>Listado de sucursales</h2>
                    <p class="checkapp-panel-copy">Consulta, filtra y administra las sucursales de la empresa activa.</p>
                </div>
                <div class="checkapp-grid-actions">
                    <span id="txSucursalesVisibleCount" class="ca-chip ca-chip--secondary">0 visibles</span>
                    <div class="checkapp-grid-columns">
                        <button id="btColumnasSucursales" type="button" class="checkapp-btn checkapp-btn-ghost">
                            <i class="fa fa-columns"></i>
                            <span>Columnas</span>
                        </button>
                        <div id="panelColumnasSucursales" class="checkapp-grid-columns-panel"></div>
                    </div>
                    <button id="btExportarSucursales" type="button" class="checkapp-btn checkapp-btn-excel">
                        <i class="fa fa-file-excel-o"></i>
                        <span>Exportar Excel</span>
                    </button>
                </div>
            </div>

            <div id="gridSucursalesHost">
                <div class="checkapp-grid-toolbar">
                    <label class="checkapp-grid-search" for="txBusquedaGridSucursales">
                        <i class="fa fa-search"></i>
                        <input id="txBusquedaGridSucursales" type="text" placeholder="Busca dentro del resultado filtrado" />
                    </label>
                    <span id="txGridSucursalesCount" class="ca-grid-count">0 registros</span>
                </div>
                <div class="checkapp-grid-scroll">
                    <table id="grData" class="table table-row-bordered align-middle checkapp-grid-table">
                        <thead>
                            <tr>
                                <th>Acciones</th>
                                <th>Nombre</th>
                                <th>Dirección</th>
                                <th>Ciudad</th>
                                <th>Teléfono</th>
                                <th>Correo</th>
                                <th>País</th>
                                <th>Razón Social</th>
                                <th>Región</th>
                                <th>Estatus</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <div class="checkapp-grid-footer">
                    <span id="txGridSucursalesRange" class="checkapp-grid-footer-range">Sin resultados</span>
                    <div id="txGridSucursalesPageSize" class="checkapp-grid-page-size">
                        <span class="checkapp-grid-page-size-label">Filas:</span>
                        <button type="button" class="checkapp-grid-page-chip is-active" data-page-size="25" aria-pressed="true">25</button>
                        <button type="button" class="checkapp-grid-page-chip" data-page-size="50" aria-pressed="false">50</button>
                        <button type="button" class="checkapp-grid-page-chip" data-page-size="100" aria-pressed="false">100</button>
                    </div>
                    <div class="checkapp-grid-page-nav">
                        <span id="txGridSucursalesPageIndicator" class="checkapp-grid-footer-page">Página 1 de 1</span>
                        <button id="btGridSucursalesPrev" type="button" class="checkapp-grid-nav-btn" aria-label="Página anterior">‹</button>
                        <button id="btGridSucursalesNext" type="button" class="checkapp-grid-nav-btn" aria-label="Página siguiente">›</button>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

<div class="modal fade checkapp-modal activos-quick-modal ps-catalog-modal ca-catalog-modal" tabindex="-1" id="modalNuevo">
    <div class="modal-dialog modal-lg modal-dialog-centered ps-catalog-modal-dialog ca-catalog-modal-dialog ca-catalog-modal-dialog--expanded">
        <div class="modal-content ps-catalog-modal-content ca-catalog-modal-content">
            <form id="frmSucursal" class="ps-catalog-modal-form ca-catalog-modal-form" data-quick-catalog-layout="sucursal" novalidate="novalidate">
                <div class="modal-header">
                    <div>
                        <p class="checkapp-kicker" id="txSucursalesModalKicker">Registro</p>
                        <h3 id="modalTitle" class="modal-title">Nueva sucursal</h3>
                    </div>
                    <button type="button" class="btn btn-icon btn-sm btn-active-light-primary" data-bs-dismiss="modal" aria-label="Cerrar">
                        <i class="ki-duotone ki-cross fs-1"><span class="path1"></span><span class="path2"></span></i>
                    </button>
                </div>
                <div class="modal-body ps-catalog-modal-body">
                    <div class="checkapp-filter-grid activos-quick-modal-grid ps-catalog-form-grid ca-catalog-form-grid ca-catalog-form-grid--sucursal">
                        <label class="checkapp-field ps-catalog-field ca-span-6">
                            <span class="visually-hidden">Nombre *</span>
                            <input id="txNombre" name="txNombre" maxlength="50" type="text" placeholder="Nombre de la sucursal" />
                        </label>
                        <label class="checkapp-field ps-catalog-field ca-span-6">
                            <span class="visually-hidden">Dirección *</span>
                            <input id="txCalle" name="txCalle" maxlength="50" type="text" placeholder="Dirección" />
                        </label>
                        <label class="checkapp-field ps-catalog-field ca-span-4">
                            <span class="visually-hidden">Ciudad *</span>
                            <input id="txCiudad" name="txCiudad" maxlength="50" type="text" placeholder="Ciudad" />
                        </label>
                        <label class="checkapp-field ps-catalog-field ca-span-4">
                            <span class="visually-hidden">Teléfono *</span>
                            <input id="txTelefono" name="txTelefono" maxlength="10" type="text" placeholder="Teléfono" />
                        </label>
                        <label class="checkapp-field ps-catalog-field ca-span-4">
                            <span class="visually-hidden">Correo *</span>
                            <input id="txCorreo" name="txCorreo" maxlength="50" type="email" placeholder="correo@empresa.com" />
                        </label>
                        <label class="checkapp-field ps-catalog-field ca-span-4">
                            <span class="visually-hidden">País *</span>
                            <input id="txPais" name="txPais" maxlength="50" type="text" placeholder="País" />
                        </label>
                        <label class="checkapp-field ps-catalog-field ca-span-4">
                            <span class="visually-hidden">Razón social *</span>
                            <select id="cbRazon" name="cbRazon" class="form-select" aria-label="Razón social"></select>
                        </label>
                        <label class="checkapp-field ps-catalog-field ca-span-4">
                            <span class="visually-hidden">Región *</span>
                            <select id="cbZonas" name="cbZonas" class="form-select" aria-label="Región"></select>
                        </label>
                        <label class="checkapp-field ps-catalog-field ps-catalog-field--description ca-span-12 ca-field-notes">
                            <span class="visually-hidden">Descripción</span>
                            <textarea id="txNotas" class="checkapp-richtext-input" data-checkapp-rich-text="true" placeholder="Descripción"></textarea>
                        </label>
                    </div>
                </div>
                <div class="modal-footer activos-quick-modal-footer ps-catalog-modal-footer">
                    <button type="button" class="checkapp-btn checkapp-btn-ghost" data-bs-dismiss="modal">
                        <i class="fa fa-ban"></i>
                        <span>Cancelar</span>
                    </button>
                    <button id="btGuardar" type="button" class="checkapp-btn checkapp-btn-primary">
                        <i class="fa fa-save"></i>
                        <span>Guardar</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<input type="hidden" id="valorId" name="valorId" value="" />

@section Scripts {
    <link href="~/css/checkapp-theme.css" rel="stylesheet" />
    <link href="~/css/ProductosServicios/ProductosServicios.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/checkapp-admin-catalogs.css" rel="stylesheet" asp-append-version="true" />
    <script>var XLSX = window.XLSX || {}; window.XLSX = XLSX;</script>
    <script src="~/js/vendor/xlsx.full.min.js"></script>
    <script src="~/js/checkapp-ui.js"></script>
    <script src="~/assets/plugins/custom/tinymce/tinymce.bundle.js"></script>
    <script src="~/js/checkapp-admin-catalogs.js" asp-append-version="true"></script>
    <script src="~/js/Sucursales/Sucursales.js" asp-append-version="true"></script>
}
