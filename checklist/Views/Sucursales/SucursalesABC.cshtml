<!-- Modal Nueva Zona -->
<div id="modalNuevaZona" class="modal fade" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title">Nueva región </h3>
                <div class="btn btn-icon btn-sm btn-active-light-primary ms-2" data-bs-dismiss="modal" aria-label="Close">
                    <i class="ki-duotone ki-cross fs-1"><span class="path1"></span><span class="path2"></span></i>
                </div>
            </div>
            <form class="form w-100" novalidate="novalidate" id="frmZona">
                <div class="modal-body">
                    <div class="form-group row">
                        <div class="col-md-8 col-sm-12 form-floating fv-row">
                            <input id="txNombreZona" name="txNombreZona" class="form-control form-control-lg form-control-solid" type="text" maxlength="50" placeholder="Nombre" />
                            <label class="ml-1" for="txNombreZona">Nombre <span class="text-danger">*</span></label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <a href="javascript:;" class="btn btn-danger font-weight-bolder" data-bs-dismiss="modal">
                        <span class="svg-icon svg-icon-primary svg-icon-2x">
                            <i class="fa fa-ban"></i>
                        </span>&nbsp;&nbsp;Cancelar
                    </a>
                    <a id="btGuardarZona" href="javascript:;" class="btn btn-primary font-weight-bolder">
                        <span class="svg-icon svg-icon-primary svg-icon-2x">
                            <i class="fa fa-save"></i>
                        </span>&nbsp;&nbsp;Guardar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Nueva Razón Social -->
<div id="modalNuevaRazonSocial" class="modal fade" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title">Nueva Razón Social</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form class="form w-100" novalidate="novalidate" id="frmRazonSocial">
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-12 form-floating">
                            <input id="txNombreRazon" name="txNombreRazon" class="form-control form-control-lg form-control-solid" type="text" maxlength="50" placeholder="Nombre" required />
                            <label for="txNombreRazon">Nombre <span class="text-danger">*</span></label>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-12 form-floating">
                            <input id="txRFC" name="txRFC" class="form-control form-control-lg form-control-solid" type="text" maxlength="13" placeholder="RFC" value="XAXX010101000" required />
                            <label for="txRFC">RFC <span class="text-danger">*</span></label>
                        </div>
                    </div>
                    <!--
                    Descomentar para añadir dirección
                    <div class="row mb-3">
                        <div class="col-md-12 form-floating">
                            <input id="txDireccionRazon" name="txDireccionRazon" class="form-control form-control-lg form-control-solid" type="text" maxlength="50" placeholder="Dirección" required />
                            <label for="txDireccionRazon">Dirección <span class="text-danger">*</span></label>
                        </div>
                    </div>
                    -->
                </div>
                <div class="modal-footer text-end">
                    <button type="button" class="btn btn-danger" data-bs-dismiss="modal">
                        <i class="fa fa-ban me-2"></i>Cancelar
                    </button>
                    <button id="btGuardarRazon" type="button" class="btn btn-primary">
                        <i class="fa fa-save me-2"></i>Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

