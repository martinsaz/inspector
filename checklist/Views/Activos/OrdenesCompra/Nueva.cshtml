@{
    ViewBag.Title = "Órdenes de compra";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var pageMode = (ViewData["OrdenesCompraPageMode"]?.ToString() ?? "new").Trim().ToLowerInvariant();
    var detailId = (ViewData["OrdenesCompraDetailId"]?.ToString() ?? string.Empty).Trim();
}

<partial name="~/Views/Activos/_ActivosSessionContext.cshtml" />

<div class="checkapp-scope checkapp-page oc-page" data-oc-page="editor" data-oc-mode="@pageMode" data-oc-id="@detailId">
    <div class="container-fluid checkapp-shell oc-shell">
        <section class="checkapp-hero oc-hero">
            <div class="oc-hero-copy">
                <p class="checkapp-kicker">Proveeduría</p>
                <h1 id="txOcHeroTitle">Orden de compra</h1>
                <p id="txOcHeroDescription">Captura la orden paso a paso, valida sus partidas y decide si quieres guardarla o generarla.</p>
            </div>
        </section>

        <section class="oc-stepper" aria-label="Pasos de la orden de compra">
            <button type="button" class="oc-stepper-item" data-step-target="1">
                <span class="oc-stepper-index">1</span>
                <span class="oc-stepper-copy">
                    <strong>Configuración</strong>
                    <small id="txOcStepState1">Pendiente</small>
                </span>
            </button>
            <button type="button" class="oc-stepper-item" data-step-target="2">
                <span class="oc-stepper-index">2</span>
                <span class="oc-stepper-copy">
                    <strong>Sucursales destino</strong>
                    <small id="txOcStepState2">Bloqueado</small>
                </span>
            </button>
            <button type="button" class="oc-stepper-item" data-step-target="3">
                <span class="oc-stepper-index">3</span>
                <span class="oc-stepper-copy">
                    <strong>Producto / servicio</strong>
                    <small id="txOcStepState3">Bloqueado</small>
                </span>
            </button>
            <button type="button" class="oc-stepper-item" data-step-target="4">
                <span class="oc-stepper-index">4</span>
                <span class="oc-stepper-copy">
                    <strong>Captura</strong>
                    <small id="txOcStepState4">Bloqueado</small>
                </span>
            </button>
            <button type="button" class="oc-stepper-item" data-step-target="5">
                <span class="oc-stepper-index">5</span>
                <span class="oc-stepper-copy">
                    <strong>Partidas / Guardar</strong>
                    <small id="txOcStepState5">Bloqueado</small>
                </span>
            </button>
        </section>

        <main class="oc-main oc-main--continuous">
                <section class="checkapp-panel oc-panel oc-preparation" data-step-panel="1" id="panelOcPreparacion">
                    <div class="checkapp-panel-head oc-preparation-head">
                        <div>
                            <span class="checkapp-panel-eyebrow">Preparación de orden</span>
                            <h2>Pasos 1 y 2</h2>
                            <p class="checkapp-panel-copy">Define proveedor, fechas y sucursales destino antes de comenzar la captura.</p>
                        </div>
                        <button id="btOcEditarPreparacion" type="button" class="checkapp-btn checkapp-btn-ghost" hidden>
                            <i class="fa fa-pencil"></i><span>Editar preparación</span>
                        </button>
                    </div>

                    <div id="panelOcPreparationSummary" class="oc-preparation-summary" hidden>
                        <div><small>Proveedor</small><strong id="txOcSummaryProveedor">—</strong></div>
                        <div><small>Sucursales seleccionadas</small><strong id="txOcSummarySucursales">—</strong></div>
                        <div><small>Fecha llegada</small><strong id="txOcSummaryFechaLlegada">—</strong></div>
                        <div><small>Fecha mínima</small><strong id="txOcSummaryFechaMinima">—</strong></div>
                        <div><small>Fecha máxima</small><strong id="txOcSummaryFechaMaxima">—</strong></div>
                        <div id="panelOcSummaryFolio" hidden><small>Folio</small><strong id="txOcSummaryFolio">—</strong></div>
                        <div id="panelOcSummarySucursalChips" class="oc-preparation-summary-chips"></div>
                    </div>

                    <div id="panelOcPreparationEditor" class="oc-preparation-grid">
                        <section class="oc-preparation-card" id="panelOcPaso1">
                            <div class="oc-block-head"><div><span>Paso 1</span><h3>Configuración</h3></div><strong id="txOcBlockState1" class="oc-state-pill">Pendiente</strong></div>
                            <input id="txOcFechaOrden" type="hidden" />
                            <select id="cbOcRazonSocial" hidden aria-hidden="true"></select>
                            <div class="checkapp-filter-grid oc-form-grid oc-form-grid--legacy-config">
                                <label class="checkapp-field oc-field oc-field--wide oc-hint-field"><span>Proveedor *</span><select id="cbOcProveedor" class="form-select"></select></label>
                                <label class="checkapp-field oc-field oc-hint-field"><span>Folio (opcional)</span><input id="txOcFolioReferencia" maxlength="100" placeholder="Referencia del proveedor" /></label>
                                <label class="checkapp-field oc-field oc-hint-field"><span>Fecha de llegada</span><input id="txOcFechaLlegada" type="date" /></label>
                                <label class="checkapp-field oc-field oc-hint-field"><span>Fecha mínima</span><input id="txOcFechaMinima" type="date" /></label>
                                <label class="checkapp-field oc-field oc-hint-field"><span>Fecha máxima</span><input id="txOcFechaMaxima" type="date" /></label>
                            </div>
                            <details class="oc-options" id="panelOcOpciones">
                                <summary><i class="fa fa-sliders"></i><span><strong>Observaciones y filtros opcionales</strong><small>Observaciones, folio y filtro por proveedor</small></span></summary>
                                <div class="oc-options-body">
                                    <label class="checkapp-field oc-field oc-hint-field"><span>Observaciones</span><textarea id="txOcObservaciones" maxlength="1000" placeholder="Observaciones"></textarea></label>
                                    <label class="oc-check"><input id="ckOcSoloProveedor" type="checkbox" checked /><span>Solo productos de este proveedor</span></label>
                                </div>
                            </details>
                        </section>

                        <section class="oc-preparation-card" id="panelOcPaso2" data-step-panel="2">
                            <div class="oc-block-head"><div><span>Paso 2</span><h3>Sucursales destino</h3></div><strong id="txOcBlockState2" class="oc-state-pill">Bloqueado</strong></div>
                            <label class="checkapp-field oc-field oc-hint-field"><span>Sucursales destino *</span><select id="cbOcSucursal" class="form-select"></select></label>
                            <div id="panelOcSucursalChips" class="oc-destination-chips" aria-live="polite"></div>
                            <div id="panelOcDestinationHelp" class="oc-gate-message"><strong>Selecciona una o más sucursales destino para comenzar la captura.</strong><span>Cada partida conservará su sucursal de forma explícita.</span></div>
                            <div id="panelOcDestinationSelected" class="oc-destination-selected" hidden><small>Sucursales disponibles para las partidas</small><strong id="txOcDestinationSelected">—</strong></div>
                        </section>
                    </div>
                </section>

                <section class="checkapp-panel oc-panel oc-panel--wizard" data-step-panel="3" id="panelOcPaso3">
                    <div class="checkapp-panel-head">
                        <div>
                            <span class="checkapp-panel-eyebrow">Paso 3</span>
                            <h2>Producto / servicio</h2>
                            <p class="checkapp-panel-copy">Busca por código, nombre o descripción y selecciona el concepto que deseas capturar.</p>
                        </div>
                    </div>

                    <div class="oc-search-layout">
                        <div class="checkapp-filter-grid oc-form-grid oc-form-grid--search">
                            <label class="checkapp-field oc-field oc-field--search oc-hint-field">
                                <span>Buscar producto o servicio</span>
                                <input id="txOcBuscarProductoServicio" type="text" placeholder="Código, nombre o descripción" />
                            </label>
                            <label class="checkapp-field oc-field oc-hint-field">
                                <span>Tipo</span>
                                <select id="cbOcBuscarTipo" class="form-select">
                                    <option value="">Todos</option>
                                    <option value="1">Producto</option>
                                    <option value="2">Servicio</option>
                                </select>
                            </label>
                        </div>
                        <div class="checkapp-filter-actions oc-search-actions">
                            <button id="btOcLimpiarBusquedaProductoServicio" type="button" class="checkapp-btn checkapp-btn-ghost">
                                <i class="fa fa-eraser"></i>
                                <span>Limpiar</span>
                            </button>
                        </div>
                    </div>

                    <div class="oc-search-results" id="panelOcResultadosBusqueda">
                        <div class="checkapp-grid-toolbar">
                            <strong>Resultados de búsqueda</strong>
                            <div class="oc-grid-toolbar-meta oc-grid-toolbar-meta--tight">
                                <span id="txOcBusquedaSpinner" class="oc-inline-spinner" hidden></span>
                                <span id="txOcBusquedaResultadosCount" class="ca-grid-count">0 resultados</span>
                                <span class="oc-search-hint">La búsqueda inicia automáticamente.</span>
                            </div>
                        </div>
                        <div id="grOcResultadosBusqueda" class="oc-product-results" aria-live="polite"></div>
                        <div id="txOcBusquedaEstado" class="checkapp-status-inline"></div>
                    </div>

                    <div id="txOcProductGate" class="oc-gate-message"><strong>Primero completa proveedor y sucursal destino.</strong><span>Después podrás buscar y seleccionar un producto o servicio.</span></div>
                    <button id="btOcPaso3Anterior" type="button" class="oc-hidden-control" tabindex="-1">Regresar</button>
                </section>

                <section class="checkapp-panel oc-panel oc-panel--wizard" data-step-panel="4" id="panelOcPaso4">
                    <div class="checkapp-panel-head">
                        <div>
                            <span class="checkapp-panel-eyebrow">Paso 4</span>
                            <h2>Captura</h2>
                            <p class="checkapp-panel-copy">Define variante, presentación de compra y cantidad del concepto seleccionado.</p>
                        </div>
                    </div>

                    <div class="oc-capture-product">
                        <div class="oc-line-title">
                            <small id="txOcCapturaTipo">Producto / servicio</small>
                            <strong id="txOcCapturaNombre">Selecciona un concepto en el paso anterior.</strong>
                            <span id="txOcCapturaCodigo" class="oc-muted">—</span>
                        </div>
                    </div>
                    <div id="txOcCaptureGate" class="oc-gate-message"><strong>La captura espera un producto o servicio.</strong><span>Selecciona un resultado en el paso 3 para definir variante, presentación y cantidad.</span></div>
                    <div class="oc-step-actions">
                        <button id="btOcPaso4Anterior" type="button" class="oc-hidden-control" tabindex="-1">Regresar</button>
                        <button id="btOcAbrirCaptura" type="button" class="checkapp-btn checkapp-btn-primary"><i class="fa fa-sliders"></i><span>Capturar sucursales y cantidades</span></button>
                    </div>
                </section>

                <section class="checkapp-panel oc-panel oc-panel--wizard" data-step-panel="5" id="panelOcPaso5">
                    <div class="checkapp-panel-head">
                        <div>
                            <span class="checkapp-panel-eyebrow">Paso 5</span>
                            <h2>Partidas / Guardar</h2>
                            <p class="checkapp-panel-copy">Ajusta cantidades y costos; después guarda el borrador o genera la orden.</p>
                        </div>
                    </div>

                    <div class="oc-partidas-section">
                        <div class="checkapp-grid-toolbar">
                            <strong>Partidas capturadas</strong>
                            <div class="oc-grid-toolbar-meta">
                                <label class="checkapp-field oc-field oc-field--toolbar">
                                    <span>Buscar dentro de partidas</span>
                                    <input id="txOcBuscarPartidas" type="text" placeholder="Código, nombre o descripción" />
                                </label>
                                <span id="txOcPartidasCount" class="ca-grid-count">0 partidas</span>
                            </div>
                        </div>
                        <div class="checkapp-grid-scroll">
                            <table class="table table-row-bordered align-middle checkapp-grid-table oc-grid-table" id="grOcPartidas">
                                <thead>
                                    <tr>
                                        <th>Sucursal</th>
                                        <th>Concepto</th>
                                        <th>Variante</th>
                                        <th>Presentación compra</th>
                                        <th>Cantidad</th>
                                        <th>Costo</th>
                                        <th>Importe</th>
                                        <th>Editar / eliminar</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                        <div id="txOcPartidasEstadoVacio" class="oc-empty-state">Agrega al menos un producto o servicio a la orden.</div>
                    </div>

                    <div class="oc-order-totals" aria-label="Totales de la orden">
                        <span>Renglones <strong id="txOcRenglones">0</strong></span>
                        <span>Piezas <strong id="txOcPiezas">0</strong></span>
                        <span>Subtotal <strong id="txOcSubtotal">$0.00</strong></span>
                        <span>Total <strong id="txOcTotal">$0.00</strong></span>
                    </div>

                    <section class="checkapp-panel oc-panel oc-panel--cancelled" id="panelOcCancelacion" hidden>
                        <div class="checkapp-panel-head">
                            <div>
                                <span class="checkapp-panel-eyebrow">Cancelación</span>
                                <h3>Historial de cancelación</h3>
                                <p class="checkapp-panel-copy">La orden conserva su información y su motivo para mantener la trazabilidad.</p>
                            </div>
                        </div>
                        <div class="checkapp-filter-grid oc-form-grid oc-form-grid--cancelled">
                            <label class="checkapp-field oc-field">
                                <span>Fecha de cancelación</span>
                                <input id="txOcFechaCancelacion" type="text" readonly />
                            </label>
                            <label class="checkapp-field oc-field oc-field--full">
                                <span>Motivo de cancelación</span>
                                <textarea id="txOcMotivoCancelacion" readonly></textarea>
                            </label>
                        </div>
                    </section>

                    <div class="oc-step-actions oc-step-actions--review">
                        <button id="btOcPaso5Anterior" type="button" class="oc-hidden-control" tabindex="-1">Regresar</button>
                        <button id="btOcGuardar" type="button" class="checkapp-btn checkapp-btn-secondary">
                            <i class="fa fa-save"></i>
                            <span>Guardar borrador</span>
                        </button>
                        <button id="btOcGenerar" type="button" class="checkapp-btn checkapp-btn-primary" hidden>
                            <i class="fa fa-check-circle"></i>
                            <span>Generar orden</span>
                        </button>
                        <button id="btOcCancelar" type="button" class="checkapp-btn checkapp-btn-ghost" hidden>
                            <i class="fa fa-ban"></i>
                            <span>Cancelar orden</span>
                        </button>
                    </div>
                    <div id="txOcSaveGate" class="oc-gate-message oc-gate-message--warning"><strong>No se puede guardar todavía.</strong><span>Completa la preparación y agrega al menos un renglón.</span></div>
                    <div class="oc-step-actions oc-step-actions--exports" id="panelOcExportaciones" hidden>
                        <button id="btOcExportarPdf" type="button" class="checkapp-btn checkapp-btn-secondary">
                            <i class="fa fa-file-pdf-o"></i>
                            <span>Exportar PDF</span>
                        </button>
                        <button id="btOcExportarExcel" type="button" class="checkapp-btn checkapp-btn-excel">
                            <i class="fa fa-file-excel-o"></i>
                            <span>Exportar Excel</span>
                        </button>
                    </div>
                </section>

            <div id="txOcFormStatus" class="checkapp-status-inline"></div>
        </main>
    </div>
</div>

<div class="modal fade checkapp-modal" tabindex="-1" id="modalOcCaptura">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content oc-modal-content">
            <div class="modal-header">
                <div><p class="checkapp-kicker">Paso 4 · Captura</p><h3 class="modal-title">Selecciona sucursales, variantes y cantidad</h3></div>
                <button type="button" class="btn btn-icon btn-sm btn-active-light-primary" data-bs-dismiss="modal" aria-label="Cerrar"><i class="fa fa-times"></i></button>
            </div>
            <div class="modal-body oc-modal-body">
                <div id="panelOcCaptureConcept" class="oc-capture-modal-concept"></div>
                <div class="oc-capture-legend" id="panelOcCaptureLegend">
                    <span><i class="oc-dot oc-dot--green"></i>Verde: curva configurada automáticamente</span>
                    <span><i class="oc-dot oc-dot--blue"></i>Azul: curva manual para esta orden</span>
                    <span><i class="oc-dot oc-dot--amber"></i>Ámbar: falta resolver o marcar no pedir</span>
                    <span><i class="oc-dot oc-dot--gray"></i>Gris: no pedir este producto en esta sucursal</span>
                </div>
                <p id="txOcCaptureDisclaimer" class="oc-capture-disclaimer">La selección manual de curva aplica sólo a esta orden. Para configuración permanente usa el módulo de Curvas.</p>
                <div class="oc-capture-global" id="panelOcCaptureGlobal">
                    <div><strong>Aplicar modo a todas las sucursales</strong><span>Requiere confirmación y sólo afecta esta captura.</span></div>
                    <div class="oc-capture-global-actions">
                        <button type="button" data-capture-global-mode="1"><i class="fa fa-pencil"></i>Manual</button>
                        <button type="button" data-capture-global-mode="2"><i class="fa fa-archive"></i>Pedido inicial</button>
                        <button type="button" data-capture-global-mode="3"><i class="fa fa-magic"></i>Rellenar curva</button>
                        <button type="button" data-capture-global-mode="4"><i class="fa fa-minus-circle"></i>No pedir</button>
                    </div>
                </div>
                <div id="panelOcCaptureRows" class="oc-capture-rows"></div>
                <div id="txOcCaptureStatus" class="checkapp-status-inline"></div>
            </div>
            <div class="modal-footer oc-modal-footer">
                <button type="button" class="checkapp-btn checkapp-btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <button id="btOcAgregarPartida" type="button" class="checkapp-btn checkapp-btn-primary"><i class="fa fa-cart-plus"></i><span>Agregar partidas</span></button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade checkapp-modal" tabindex="-1" id="modalOcCancelar">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content oc-modal-content">
            <form id="frmOcCancelar">
                <div class="modal-header">
                    <div>
                        <p class="checkapp-kicker">Proveeduría</p>
                        <h3 class="modal-title">Cancelar orden de compra</h3>
                    </div>
                    <button type="button" class="btn btn-icon btn-sm btn-active-light-primary" data-bs-dismiss="modal" aria-label="Close">
                        <i class="ki-duotone ki-cross fs-1"><span class="path1"></span><span class="path2"></span></i>
                    </button>
                </div>
                <div class="modal-body oc-modal-body">
                    <label class="checkapp-field oc-field oc-field--full">
                        <span>Motivo de cancelación *</span>
                        <textarea id="txOcCancelarMotivo" maxlength="500" placeholder="Explica por qué la orden ya no debe continuar."></textarea>
                    </label>
                    <div id="txOcCancelarStatus" class="checkapp-status-inline"></div>
                </div>
                <div class="modal-footer oc-modal-footer">
                    <button type="button" class="checkapp-btn checkapp-btn-ghost" data-bs-dismiss="modal">
                        <span>Cerrar</span>
                    </button>
                    <button id="btOcConfirmarCancelar" type="button" class="checkapp-btn checkapp-btn-primary">
                        <i class="fa fa-ban"></i>
                        <span>Cancelar orden</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div id="ocEditorOverlay" class="oc-overlay" aria-hidden="true" hidden>
    <div class="oc-overlay-card" role="status" aria-live="polite">
        <div class="oc-overlay-spinner"></div>
        <div class="oc-overlay-copy">
            <strong id="txOcOverlayTitle">Guardando orden...</strong>
            <p id="txOcOverlayText">Estamos preparando la información de tu orden.</p>
        </div>
    </div>
</div>

@section Scripts {
    <link href="~/css/checkapp-theme.css" rel="stylesheet" />
    <link href="~/css/Activos/OrdenesCompra/OrdenesCompra.css" rel="stylesheet" asp-append-version="true" />
    <script src="~/js/checkapp-ui.js"></script>
    <script src="~/js/Activos/OrdenesCompra/OrdenesCompra.js" asp-append-version="true"></script>
}
