@{
    ViewBag.Title = "Razones Sociales";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="checkapp-admin-page checkapp-page razones-sociales-page">
    <div class="container-fluid checkapp-shell">
        <section class="checkapp-hero">
            <div>
                <p class="checkapp-kicker">CheckApp Pro</p>
                <h1>Razones Sociales</h1>
                <p>Administra la información fiscal y legal vinculada a la operación.</p>
            </div>
            <div class="checkapp-hero-actions">
                <button id="btNuevo" type="button" class="checkapp-btn checkapp-btn-primary">
                    <i class="fa fa-plus"></i>
                    <span>Nuevo</span>
                </button>
            </div>
        </section>

        <section id="accordionFiltrosRazones" class="checkapp-panel checkapp-accordion is-open">
            <button type="button" class="checkapp-accordion-toggle" aria-expanded="true" aria-controls="accordionFiltrosRazonesBody">
                <div>
                    <span class="checkapp-panel-eyebrow">Filtros</span>
                    <h3>Encuentra razones sociales por nombre, RFC, representante o ubicación.</h3>
                </div>
                <span class="checkapp-accordion-summary">Sin filtros activos</span>
            </button>
            <div class="checkapp-accordion-body" id="accordionFiltrosRazonesBody">
                <div class="checkapp-accordion-inner">
                    <div class="checkapp-filter-grid">
                        <label class="checkapp-field ca-field-span-2">
                            <span>Búsqueda general</span>
                            <input id="txFiltroRazonesBusqueda" type="text" placeholder="Razón social, RFC o representante" />
                        </label>
                        <label class="checkapp-field">
                            <span>Ciudad</span>
                            <input id="txFiltroRazonesCiudad" type="text" placeholder="Ciudad" />
                        </label>
                        <label class="checkapp-field">
                            <span>Estado</span>
                            <input id="txFiltroRazonesEstado" type="text" placeholder="Estado" />
                        </label>
                    </div>
                    <div class="checkapp-filter-actions mt-4">
                        <button id="btBuscarRazones" type="button" class="checkapp-btn checkapp-btn-secondary">
                            <i class="fa fa-search"></i>
                            <span>Buscar</span>
                        </button>
                        <button id="btLimpiarRazones" type="button" class="checkapp-btn checkapp-btn-ghost">
                            <i class="fa fa-eraser"></i>
                            <span>Limpiar</span>
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <section class="checkapp-panel">
            <div class="checkapp-panel-head">
                <div>
                    <span class="checkapp-panel-eyebrow">Catálogo fiscal</span>
                    <h2>Listado de razones sociales</h2>
                    <p class="checkapp-panel-copy">Consulta, filtra y administra cada registro fiscal desde una sola pantalla.</p>
                </div>
                <div class="checkapp-grid-actions">
                    <span id="txRazonesVisibleCount" class="ca-chip ca-chip--secondary">0 visibles</span>
                    <div class="checkapp-grid-columns">
                        <button id="btColumnasRazones" type="button" class="checkapp-btn checkapp-btn-ghost">
                            <i class="fa fa-columns"></i>
                            <span>Columnas</span>
                        </button>
                        <div id="panelColumnasRazones" class="checkapp-grid-columns-panel"></div>
                    </div>
                    <button id="btExportarRazones" type="button" class="checkapp-btn checkapp-btn-excel">
                        <i class="fa fa-file-excel-o"></i>
                        <span>Exportar Excel</span>
                    </button>
                </div>
            </div>

            <div id="gridRazonesHost">
                <div class="checkapp-grid-toolbar">
                    <label class="checkapp-grid-search" for="txBusquedaGridRazones">
                        <i class="fa fa-search"></i>
                        <input id="txBusquedaGridRazones" type="text" placeholder="Busca dentro del resultado filtrado" />
                    </label>
                    <span id="txGridRazonesCount" class="ca-grid-count">0 registros</span>
                </div>
                <div class="checkapp-grid-scroll">
                    <table id="grData" class="table table-row-bordered align-middle checkapp-grid-table">
                        <thead>
                            <tr>
                                <th>Acciones</th>
                                <th>Razón Social</th>
                                <th>Representante</th>
                                <th>R.F.C</th>
                                <th>Dirección</th>
                                <th>Colonia</th>
                                <th>C.P.</th>
                                <th>Ciudad</th>
                                <th>Estado</th>
                                <th>País</th>
                                <th>Teléfono</th>
                                <th>Régimen Fiscal</th>
                                <th>Notas</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <div class="checkapp-grid-footer">
                    <span id="txGridRazonesRange" class="checkapp-grid-footer-range">Sin resultados</span>
                    <div id="txGridRazonesPageSize" class="checkapp-grid-page-size">
                        <span class="checkapp-grid-page-size-label">Filas:</span>
                        <button type="button" class="checkapp-grid-page-chip is-active" data-page-size="25" aria-pressed="true">25</button>
                        <button type="button" class="checkapp-grid-page-chip" data-page-size="50" aria-pressed="false">50</button>
                        <button type="button" class="checkapp-grid-page-chip" data-page-size="100" aria-pressed="false">100</button>
                    </div>
                    <div class="checkapp-grid-page-nav">
                        <span id="txGridRazonesPageIndicator" class="checkapp-grid-footer-page">Página 1 de 1</span>
                        <button id="btGridRazonesPrev" type="button" class="checkapp-grid-nav-btn" aria-label="Página anterior">‹</button>
                        <button id="btGridRazonesNext" type="button" class="checkapp-grid-nav-btn" aria-label="Página siguiente">›</button>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

<div class="modal fade checkapp-modal" tabindex="-1" id="modalNuevo">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <form id="frmRazon" novalidate="novalidate">
                <div class="modal-header">
                    <div>
                        <p class="checkapp-kicker" id="txRazonesModalKicker">Registro</p>
                        <h3 id="modalTitle" class="modal-title">Nueva razón social</h3>
                    </div>
                    <button type="button" class="btn btn-icon btn-sm btn-active-light-primary" data-bs-dismiss="modal" aria-label="Cerrar">
                        <i class="ki-duotone ki-cross fs-1"><span class="path1"></span><span class="path2"></span></i>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="ca-admin-form-grid">
                        <label class="checkapp-field ca-field-span-2">
                            <span>Razón Social *</span>
                            <input id="txRazon" name="txRazon" maxlength="200" type="text" placeholder="Razón social" />
                        </label>
                        <label class="checkapp-field">
                            <span>Representante *</span>
                            <input id="txRepresentante" name="txRepresentante" maxlength="255" type="text" placeholder="Representante" />
                        </label>
                        <label class="checkapp-field">
                            <span>RFC *</span>
                            <input id="txRfc" name="txRfc" maxlength="15" type="text" placeholder="XAXX010101000" />
                        </label>
                        <label class="checkapp-field ca-field-span-4">
                            <span>Dirección *</span>
                            <input id="txDireccion" name="txDireccion" maxlength="255" type="text" placeholder="Dirección fiscal" />
                        </label>
                        <label class="checkapp-field">
                            <span>Colonia *</span>
                            <input id="txColonia" name="txColonia" maxlength="255" type="text" placeholder="Colonia" />
                        </label>
                        <label class="checkapp-field">
                            <span>C.P. *</span>
                            <input id="txCP" name="txCP" maxlength="5" type="text" placeholder="C.P." />
                        </label>
                        <label class="checkapp-field">
                            <span>Ciudad *</span>
                            <input id="txCiudad" name="txCiudad" maxlength="255" type="text" placeholder="Ciudad" />
                        </label>
                        <label class="checkapp-field">
                            <span>Estado *</span>
                            <input id="txEstado" name="txEstado" maxlength="255" type="text" placeholder="Estado" />
                        </label>
                        <label class="checkapp-field">
                            <span>País *</span>
                            <input id="txPais" name="txPais" maxlength="255" type="text" placeholder="País" />
                        </label>
                        <label class="checkapp-field">
                            <span>Teléfono *</span>
                            <input id="txTelefono" name="txTelefono" maxlength="13" type="text" placeholder="Teléfono" />
                        </label>
                        <label class="checkapp-field ca-field-span-2">
                            <span>Régimen Fiscal *</span>
                            <input id="txRegimenFiscal" name="txRegimenFiscal" maxlength="200" type="text" placeholder="Régimen fiscal" />
                        </label>
                        <label class="checkapp-field ca-field-span-4">
                            <span>Notas</span>
                            <textarea id="txNotas" placeholder="Notas internas"></textarea>
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="checkapp-btn checkapp-btn-ghost" data-bs-dismiss="modal">
                        <i class="fa fa-ban"></i>
                        <span>Cancelar</span>
                    </button>
                    <button id="btGuardar" type="button" class="checkapp-btn checkapp-btn-primary">
                        <i class="fa fa-save"></i>
                        <span>Guardar</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<input type="hidden" id="valorId" name="valorId" value="" />

@section Scripts {
    <link href="~/css/ProductosServicios/ProductosServicios.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/checkapp-admin-catalogs.css" rel="stylesheet" asp-append-version="true" />
    <script>var XLSX = window.XLSX || {}; window.XLSX = XLSX;</script>
    <script src="~/js/vendor/xlsx.full.min.js"></script>
    <script src="~/js/checkapp-ui.js"></script>
    <script src="~/js/checkapp-admin-catalogs.js" asp-append-version="true"></script>
    <script src="~/js/RazonesSociales/razonessociales.js" asp-append-version="true"></script>
}
