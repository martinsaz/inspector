                            <th>País</th>
                            <th>Teléfono</th>
                            <th>Regimen Fiscal</th>
                            <th>Notas</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
